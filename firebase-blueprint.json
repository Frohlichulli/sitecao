{
  "entities": {
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "An image in the center's gallery",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL of the image"
        },
        "title": {
          "type": "string",
          "description": "The title or legend of the image"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the image was uploaded"
        }
      },
      "required": ["url", "title", "createdAt"]
    }
  },
  "firestore": {
    "gallery": {
      "schema": "GalleryImage",
      "description": "Collection of gallery images"
    }
  }
}
